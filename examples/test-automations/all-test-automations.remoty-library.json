  "snippets": [
    {
      "id": "test-ok",
      "name": "Test: say ok",
      "command": "echo all good",
      "timeoutSecs": 120
    },
    {
      "id": "test-fail",
      "name": "Test: fail on purpose",
      "command": "echo this step fails on purpose && exit /b 1",
      "timeoutSecs": 120
    },
    {
      "id": "test-after-fail",
      "name": "Test: runs only if the one before worked",
      "command": "echo you should not see this",
      "timeoutSecs": 120
    },
    {
      "id": "test-carry-on",
      "name": "Test: runs anyway",
      "command": "echo the failed step was set to continue on error",
      "timeoutSecs": 120
    },
    {
      "id": "test-ticks",
      "name": "Test: count to 60 (cancel me)",
      "command": "for i in $(seq 1 60); do echo \"tick $i\"; sleep 1; done",
      "timeoutSecs": 120
    },
    {
      "id": "test-make-1gb",
      "name": "Test: make a 1 GB file in WSL",
      "command": "fallocate -l 1G /tmp/test-1gb.bin && ls -lh /tmp/test-1gb.bin",
      "timeoutSecs": 120
    },
    {
      "id": "test-check-remote",
      "name": "Test: check the upload on the host, then remove it",
      "command": "ls -lh {{nodes.upload.output}} && rm {{nodes.upload.output}}",
      "timeoutSecs": 120
    },
    {
      "id": "test-clean-wsl",
      "name": "Test: remove the 1 GB file in WSL",
      "command": "rm -f /tmp/test-1gb.bin && echo removed",
      "timeoutSecs": 120
    },
    {
      "id": "test-build",
      "name": "Test: build (on the host)",
      "command": "echo \"building {{params.tag}} on $(hostname)\"",
      "timeoutSecs": 120
    },
    {
      "id": "test-got-it",
      "name": "Test: show what the called automation put out",
      "command": "echo got: {{nodes.release.output}}",
      "timeoutSecs": 120
    },
    {
      "id": "test-prod",
      "name": "Test: deploy to prod",
      "command": "echo deploying to {{params.env}}",
      "timeoutSecs": 120
    },
    {
      "id": "test-not-prod",
      "name": "Test: skip the deploy",
      "command": "echo not prod, nothing to deploy",
      "timeoutSecs": 120
    },
    {
      "id": "test-greet",
      "name": "Test: use a fixed variable",
      "command": "echo {{params.greeting}} from a fixed variable",
      "timeoutSecs": 120
    },
    {
      "id": "test-line",
      "name": "Test: print a few lines",
      "command": "echo line one && echo line two && echo line three",
      "timeoutSecs": 120
    },
    {
      "id": "test-slow",
      "name": "Test: take 5 seconds (WSL)",
      "command": "echo start on $(hostname); sleep 5; echo done after 5 s",
      "timeoutSecs": 120
    },
    {
      "id": "test-join",
      "name": "Test: after both branches",
      "command": "echo both branches are done",
      "timeoutSecs": 120
    }
  ]
}
