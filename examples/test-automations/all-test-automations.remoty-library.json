          "id": "no",
          "snippetId": "test-not-prod",
          "label": "skip",
          "continueOnError": false,
          "target": "local",
          "position": {
            "x": 280,
            "y": 400
          }
        }
      ],
      "edges": [
        {
          "from": "if",
          "to": "yes",
          "branch": "yes"
        },
        {
          "from": "if",
          "to": "no",
          "branch": "no"
        }
      ]
    },
